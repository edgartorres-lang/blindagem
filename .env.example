# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel.
# Só as variáveis NEXT_PUBLIC_ chegam ao navegador. Todas as outras ficam no servidor (/api/lead).

# --- Meta (Pixel + API de Conversões) ---
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Opcional: use só durante os testes e apague depois
META_TEST_EVENT_CODE=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Google (conta de serviço: Sheets + Drive) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a chave entre aspas, mantendo os \n literais
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# --- E-mail (Resend) ---
RESEND_API_KEY=
MAIL_FROM="Setor Norte Seguros <estudo@setornorteseguros.com.br>"

# --- Rate limit (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Lead ID ---
LEAD_HASH_SALT=
